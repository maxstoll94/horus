{
  "name": "horus",
  "private": true,
  "version": "1.0.1",
  "description": "Personal finance categorization and insights for offline use.",
  "author": "Horus",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "release": "tsc && vite build && electron-builder --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.6.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-select": "^5.10.2",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.horus.app",
    "productName": "Horus",
    "mac": {
      "icon": "public/horus-icon.icns"
    },
    "win": {
      "icon": "public/horus-icon.ico"
    },
    "linux": {
      "icon": "public/horus-icon-256.png"
    }
  }
}
